generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ALMACEN
  COMPRAS
  VENTAS
}

enum MovementType {
  ENTRADA
  SALIDA
  AJUSTE
  TRANSFERENCIA
}

enum PurchaseStatus {
  PENDIENTE
  PARCIAL
  RECIBIDA
  CANCELADA
}

enum SalesStatus {
  PENDIENTE
  SURTIDO_PARCIAL
  SURTIDO
  CANCELADO
}

enum QuoteStatus {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  CONVERTIDA
}

model User {
  id           Int                 @id @default(autoincrement())
  name         String
  email        String              @unique
  passwordHash String
  role         Role                @default(ALMACEN)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  movements    InventoryMovement[]

  @@map("users")
}

model Warehouse {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  name    String
  address String?
  active  Boolean @default(true)

  stocks           ProductStock[]
  movements        InventoryMovement[]
  transfersIn      InventoryMovement[] @relation("TransferDestination")
  purchaseOrders   PurchaseOrder[]
  salesOrders      SalesOrder[]

  @@map("warehouses")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  description String?
  category    String
  unit        String   @default("pieza")
  minStock    Decimal  @default(0) @db.Decimal(12, 2)
  unitCost    Decimal  @default(0) @db.Decimal(12, 2)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  location    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stocks         ProductStock[]
  movements      InventoryMovement[]
  purchaseItems  PurchaseOrderItem[]
  salesItems     SalesOrderItem[]
  quoteItems     SalesQuoteItem[]
  priceListItems PriceListItem[]

  @@map("products")
}

model ProductStock {
  id          Int       @id @default(autoincrement())
  product     Product   @relation(fields: [productId], references: [id])
  productId   Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId Int
  quantity    Decimal   @default(0) @db.Decimal(12, 2)

  @@unique([productId, warehouseId])
  @@map("product_stocks")
}

model InventoryMovement {
  id                Int          @id @default(autoincrement())
  product           Product      @relation(fields: [productId], references: [id])
  productId         Int
  warehouse         Warehouse    @relation(fields: [warehouseId], references: [id])
  warehouseId       Int
  toWarehouse       Warehouse?   @relation("TransferDestination", fields: [toWarehouseId], references: [id])
  toWarehouseId     Int?
  type              MovementType
  quantity          Decimal      @db.Decimal(12, 2)
  balanceAfter      Decimal      @db.Decimal(12, 2)
  reason            String
  reference         String?
  user              User?        @relation(fields: [userId], references: [id])
  userId            Int?
  createdAt         DateTime     @default(now())

  @@map("inventory_movements")
}

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id           Int            @id @default(autoincrement())
  folio        String         @unique
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  supplierId   Int
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id])
  warehouseId  Int
  status       PurchaseStatus @default(PENDIENTE)
  orderDate    DateTime       @default(now())
  expectedDate DateTime?
  total        Decimal        @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime       @default(now())

  items PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId Int
  product         Product       @relation(fields: [productId], references: [id])
  productId       Int
  quantity        Decimal       @db.Decimal(12, 2)
  unitCost        Decimal       @db.Decimal(12, 2)
  receivedQty     Decimal       @default(0) @db.Decimal(12, 2)

  @@map("purchase_order_items")
}

model PriceList {
  id        Int     @id @default(autoincrement())
  name      String
  isDefault Boolean @default(false)

  items     PriceListItem[]
  customers Customer[]

  @@map("price_lists")
}

model PriceListItem {
  id          Int       @id @default(autoincrement())
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  priceListId Int
  product     Product   @relation(fields: [productId], references: [id])
  productId   Int
  price       Decimal   @db.Decimal(12, 2)

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  priceList   PriceList? @relation(fields: [priceListId], references: [id])
  priceListId Int?
  createdAt   DateTime @default(now())

  salesOrders SalesOrder[]
  quotes      SalesQuote[]

  @@map("customers")
}

model SalesQuote {
  id          Int         @id @default(autoincrement())
  folio       String      @unique
  customer    Customer    @relation(fields: [customerId], references: [id])
  customerId  Int
  status      QuoteStatus @default(BORRADOR)
  quoteDate   DateTime    @default(now())
  validUntil  DateTime?
  total       Decimal     @default(0) @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime    @default(now())

  items      SalesQuoteItem[]
  salesOrder SalesOrder?

  @@map("sales_quotes")
}

model SalesQuoteItem {
  id           Int        @id @default(autoincrement())
  quote        SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId      Int
  product      Product    @relation(fields: [productId], references: [id])
  productId    Int
  quantity     Decimal    @db.Decimal(12, 2)
  unitPrice    Decimal    @db.Decimal(12, 2)

  @@map("sales_quote_items")
}

model SalesOrder {
  id           Int         @id @default(autoincrement())
  folio        String      @unique
  customer     Customer    @relation(fields: [customerId], references: [id])
  customerId   Int
  warehouse    Warehouse   @relation(fields: [warehouseId], references: [id])
  warehouseId  Int
  quote        SalesQuote? @relation(fields: [quoteId], references: [id])
  quoteId      Int?        @unique
  status       SalesStatus @default(PENDIENTE)
  orderDate    DateTime    @default(now())
  deliveryDate DateTime?
  total        Decimal     @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime    @default(now())

  items SalesOrderItem[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id            Int        @id @default(autoincrement())
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderId  Int
  product       Product    @relation(fields: [productId], references: [id])
  productId     Int
  quantity      Decimal    @db.Decimal(12, 2)
  unitPrice     Decimal    @db.Decimal(12, 2)
  deliveredQty  Decimal    @default(0) @db.Decimal(12, 2)

  @@map("sales_order_items")
}
